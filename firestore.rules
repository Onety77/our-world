rules_version = '2';

/*
  Who may touch what.

  The Firebase web API key is public — it ships in the client bundle and always
  will. This file is the actual security model, and it starts from "nobody, to
  nothing" and opens exactly two doors.

  The rule that matters: there are two people here forever. Both addresses are
  written below, and anyone else who signs in — with a real, valid Firebase
  account — reads and writes nothing at all.

  Do not fill the two addresses in by hand. Run `npm run rules`, which takes
  them from .env.local and writes rules-out/firestore.rules ready to paste.
  One place to get it right instead of three, and the failure mode of getting
  it wrong is silent: the rules just deny everything and the garden looks
  broken for no visible reason.
*/

service cloud.firestore {
  match /databases/{database}/documents {

    function warmEmail() { return '__WARM_EMAIL__'; }
    function coolEmail() { return '__COOL_EMAIL__'; }

    /**
     * The address you signed in with, lowercased.
     *
     * Lowercased on both sides because nobody types their own address the same
     * way twice, and a rule that quietly denies everything because of a capital
     * letter is a very bad afternoon.
     */
    function email() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    /*
      Deliberately not also checking `email_verified`. Both accounts are made by
      hand in the console and neither will ever be through a verification flow,
      so requiring it would lock the two of you out of your own garden — and
      it buys nothing here, because the addresses are matched exactly anyway.
    */
    function isOneOfUs() {
      return email() == warmEmail() || email() == coolEmail();
    }

    /** Which light the caller is. */
    function me() {
      return email() == warmEmail() ? 'warm' : 'cool';
    }

    function voiceLightLimit() {
      return exists(/databases/$(database)/documents/voiceLightConfig/ours)
        ? get(/databases/$(database)/documents/voiceLightConfig/ours).data.limit
        : 3;
    }

    function isVoiceSlot(id, slot) {
      return (slot == 0 && id == me() + '-0')
        || (slot == 1 && id == me() + '-1')
        || (slot == 2 && id == me() + '-2')
        || (slot == 3 && id == me() + '-3')
        || (slot == 4 && id == me() + '-4')
        || (slot == 5 && id == me() + '-5')
        || (slot == 6 && id == me() + '-6')
        || (slot == 7 && id == me() + '-7')
        || (slot == 8 && id == me() + '-8')
        || (slot == 9 && id == me() + '-9')
        || (slot == 10 && id == me() + '-10')
        || (slot == 11 && id == me() + '-11');
    }

    // ---- the world ------------------------------------------------------
    // Small and singular: the pot's currency and goal, the pollen, the moment
    // you were first here together. Either of you may set a goal.
    match /world/{id} {
      allow read: if isOneOfUs();
      allow write: if isOneOfUs();
    }

    // ---- profiles -------------------------------------------------------
    // Both readable — the distance between you and her clock are both drawn
    // from hers. Only ever writable by their owner: a name is the one thing
    // nobody else gets to change.
    match /profiles/{who} {
      allow read: if isOneOfUs();
      allow write: if isOneOfUs()
        && who == me()
        && (who == 'warm' || who == 'cool');
    }

    // ---- letters --------------------------------------------------------
    // You may leave one, signed as yourself. Letters do not come down, and
    // they are not edited after the fact — the only thing that may change on
    // an existing letter is the moment the *other* person first read it.
    match /letters/{id} {
      allow read: if isOneOfUs();

      allow create: if isOneOfUs()
        && request.resource.data.by == me()
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 8000
        && request.resource.data.placeId is string
        && request.resource.data.position is list
        && request.resource.data.position.size() == 3;

      allow update: if isOneOfUs()
        // only theirs, and only the first time
        && resource.data.by != me()
        && resource.data.readAt == null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['readAt'])
        && request.resource.data.readAt is number;

      allow delete: if false;
    }

    // ---- the pot --------------------------------------------------------
    // An honour-system ledger of money set aside in real life. Nothing here
    // moves funds. Entries are written once and never touched again: a total
    // that can be quietly edited afterwards is not a record of anything.
    match /contributions/{id} {
      allow read: if isOneOfUs();

      allow create: if isOneOfUs()
        && request.resource.data.by == me()
        && request.resource.data.amount.minor is int
        && request.resource.data.amount.currency is string
        && request.resource.data.inPotCurrency.minor is int
        && request.resource.data.rateUsed is number
        && request.resource.data.rateUsed > 0
        && request.resource.data.at is number;

      allow update, delete: if false;
    }

    // ---- the living garden ----------------------------------------------
    // Plants are planted once and then only ever watered — the three watering
    // fields are the only thing an update may touch, so nobody can quietly
    // move or re-species a plant. Either of you may water either's plant:
    // that is the point of it.
    match /plants/{id} {
      allow read: if isOneOfUs();

      allow create: if isOneOfUs()
        && request.resource.data.by == me()
        && (request.resource.data.species == 'flower'
            || request.resource.data.species == 'tree')
        && request.resource.data.position is list
        && request.resource.data.position.size() == 3
        && request.resource.data.growthDays == 0;

      allow update: if isOneOfUs()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['growthDays', 'lastWateredDay', 'lastWateredAt'])
        // growth only climbs, one day at a time, and never past full
        && request.resource.data.growthDays >= resource.data.growthDays
        && request.resource.data.growthDays <= resource.data.growthDays + 1
        && request.resource.data.growthDays <= 20;

      allow delete: if false;
    }

    // Furniture: placed once, kept forever. A world you can quietly un-decorate
    // is a world where things you loved disappear without a conversation.
    match /decor/{id} {
      allow read: if isOneOfUs();

      allow create: if isOneOfUs()
        && request.resource.data.by == me()
        && (request.resource.data.kind == 'lamp'
            || request.resource.data.kind == 'bench'
            || request.resource.data.kind == 'swing'
            || request.resource.data.kind == 'carpet')
        && request.resource.data.position is list
        && request.resource.data.position.size() == 3;

      allow update, delete: if false;
    }

    // ---- games ----------------------------------------------------------
    /*
      A round, and each move as its own document underneath it.

      This shape exists for one rule. Several of these games turn on you both
      answering without seeing each other first, and that is worth nothing if
      it can be peeked at — so her move is not withheld by the app, it is
      withheld by the server: you cannot read it until yours exists.

      That is only expressible because the moves are separate documents. In one
      shared document, "read the round" would mean reading her answer, and no
      rule could prevent it.
    */
    /*
      The Stars — what the two of you say to each other.

      Speech, not objects. A message cannot be edited and cannot be deleted,
      by anybody, including whoever wrote it: a conversation one person can
      quietly rewrite afterwards is not a record of anything. If something
      needs taking back, it gets taken back by saying so.

      Nothing here is sealed the way a game's opening move is. Both of you may
      read all of it at any time — that is what a conversation is.
    */
    /*
      The music either of you has put in the garden.

      Both of you may add and both may remove — unlike a letter or a message,
      a track is not something somebody *said*, it is furniture, and furniture
      you are stuck with because only the person who carried it in may move it
      is furniture in the way.
    */
    match /tracks/{id} {
      allow read: if isOneOfUs();
      allow write: if isOneOfUs()
        && (request.method == 'delete' || (
          request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 300
        ));
    }

    match /messages/{id} {
      allow read: if isOneOfUs();

      allow create: if isOneOfUs()
        && request.resource.data.by == me()
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        // Long enough for anything either of you would say in one breath;
        // short enough that one paste cannot fill the database.
        && request.resource.data.body.size() <= 4000
        && request.resource.data.at is number;

      /*
        A message is never edited. A *heart* on one is not editing it.

        The only field either of you may ever change on somebody else's words
        is your own key under `hearts` — the body, the author and the time are
        written once and are then the record. `affectedKeys` is what makes that
        enforceable rather than a convention: a write that touches anything
        besides `hearts.<me>` is refused here, not in the client.

        Taking a heart back is a delete of that same key, which arrives as the
        same affected key, so it needs no separate rule.
      */
      allow update: if isOneOfUs()
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['hearts'])
        // `get` with a default on *both* sides, because either one can be
        // absent: the first heart on a message arrives before the map exists,
        // and taking back the only heart can remove the map entirely. Reading
        // a missing field directly is an error, and an error is a denial — so
        // without this the two ends of a heart's life are the two that fail.
        && request.resource.data.get('hearts', {}).diff(
             resource.data.get('hearts', {})
           ).affectedKeys().hasOnly([me()]);

      allow delete: if false;
    }

    // ---- the rare voice-lights -----------------------------------------
    // One numbered place per person, overwritten deliberately rather than an
    // audio feed that grows forever. The binary is separately owned in
    // storage.rules; this is its small, drawable pulse-map.
    match /voiceLights/{id} {
      allow read: if isOneOfUs();

      allow create, update: if isOneOfUs()
        && isVoiceSlot(id, request.resource.data.slot)
        && request.resource.data.by == me()
        && request.resource.data.slot is int
        && request.resource.data.slot >= 0
        && request.resource.data.slot < voiceLightLimit()
        && request.resource.data.at is number
        && request.resource.data.duration is number
        && request.resource.data.duration > 0
        && request.resource.data.duration <= 30.5
        && request.resource.data.path is string
        && request.resource.data.path.matches('voice-lights/' + me() + '/.*')
        && request.resource.data.mime is string
        && request.resource.data.waveform is list
        && request.resource.data.waveform.size() <= 48
        && request.resource.data.keys().hasOnly([
          'by', 'slot', 'at', 'duration', 'path', 'mime', 'waveform'
        ])
        && (
          !exists(/databases/$(database)/documents/voiceLights/$(id))
          || resource.data.by == me()
        );

      allow delete: if isOneOfUs() && resource.data.by == me();
    }

    match /voiceLightConfig/{id} {
      allow read: if isOneOfUs() && id == 'ours';
      allow create, update: if isOneOfUs()
        && me() == 'warm'
        && id == 'ours'
        && request.resource.data.limit is int
        && request.resource.data.limit >= 1
        && request.resource.data.limit <= 12
        && request.resource.data.keys().hasOnly(['limit']);
      allow delete: if false;
    }

    /*
      How the car drives.

      One document of plain numbers — grip, weight, steering, camera — sent
      from the control room at /dev7731 so both phones drive the same car. Warm
      only, and for the usual reason: this is the one write in the garden whose
      entire purpose is to change something under somebody else while they are
      using it.

      **Deliberately not enumerating the dials here.** Every other rule in this
      file names its fields, and it is right to; this one cannot without the
      security model becoming a second copy of a tuning table that gains and
      loses entries every time the car is worked on — and a rules file that is
      edited to add a slider is a rules file that eventually gets edited
      carelessly. What is checked instead is the shape and the blast radius: a
      small bag of finite numbers, nothing else. The reader on the far side
      validates each value against the dial it belongs to and clamps it, which
      is where a range check can actually be kept honest.
    */
    match /rallyTuning/{id} {
      allow read: if isOneOfUs() && id == 'ours';
      allow create, update: if isOneOfUs()
        && me() == 'warm'
        && id == 'ours'
        && request.resource.data.keys().size() <= 60;
      allow delete: if false;
    }

    /*
      The authored loudness of the five places. This is world tuning, not a
      person's device volume, so Warm publishes it once and both devices read
      the same mix. Explicit fields and 0..1 bounds keep a broken control room
      from turning an AudioParam into NaN or an unsafe gain.
    */
    match /ambienceTuning/{id} {
      allow read: if isOneOfUs() && id == 'ours';
      allow create, update: if isOneOfUs()
        && me() == 'warm'
        && id == 'ours'
        && request.resource.data.keys().hasOnly([
          'tree', 'river', 'hollow', 'stars', 'glasshouse'
        ])
        && request.resource.data.tree is number
        && request.resource.data.tree >= 0
        && request.resource.data.tree <= 1
        && request.resource.data.river is number
        && request.resource.data.river >= 0
        && request.resource.data.river <= 1
        && request.resource.data.hollow is number
        && request.resource.data.hollow >= 0
        && request.resource.data.hollow <= 1
        && request.resource.data.stars is number
        && request.resource.data.stars >= 0
        && request.resource.data.stars <= 1
        && request.resource.data.glasshouse is number
        && request.resource.data.glasshouse >= 0
        && request.resource.data.glasshouse <= 1;
      allow delete: if false;
    }

    /*
      The Glasshouse.

      A memory is a photograph plus at most two short lines, and the picture
      itself is not in here — it is in the bucket, under `storage.rules`. What
      this document holds is where the pane stands, what colour it is, and the
      sixteen-pixel preview that lets the whole building be drawn before a
      single photograph has been fetched.

      **Written once, by one person, and then almost immutable.** The one thing
      the other one may ever add is `theirs` — what they remember of it — and
      the rule below is the enforcement of "one person leaves the moment, the
      other leaves what it meant from where they stood". Not a like. Not a
      thread. One line, from the one who did not hang it.
    */
    match /memories/{id} {
      allow read: if isOneOfUs();

      allow create: if isOneOfUs()
        && request.resource.data.by == me()
        && request.resource.data.at is number
        // The picture has to exist before the document does — the layer
        // uploads first for exactly this reason. An empty path would be a
        // permanent pane in the building with nothing behind it.
        && request.resource.data.path is string
        && request.resource.data.path.size() > 0
        && request.resource.data.path.size() <= 200
        // The pane is cut to these. A missing or silly size would either
        // divide by zero or hang a photograph a kilometre wide.
        && request.resource.data.width is number
        && request.resource.data.width > 0
        && request.resource.data.height is number
        && request.resource.data.height > 0
        && request.resource.data.tint is string
        && request.resource.data.tint.size() <= 9
        // Sixteen pixels of JPEG in a data URI. Four kilobytes is generous for
        // that and still nowhere near being a way to store a real picture in
        // Firestore, which is what this bound is actually for.
        && request.resource.data.blur is string
        && request.resource.data.blur.size() <= 4000
        && request.resource.data.get('when', '').size() <= 200
        && request.resource.data.get('why', '').size() <= 600;

      /*
        Only `theirs`, only from the other one, and only ever about themselves.

        `affectedKeys().hasOnly(['theirs'])` is what makes the rest of the
        document a record rather than a convention — the picture, its colours,
        its size and the line the person who hung it wrote cannot be touched by
        anybody, including them.

        `resource.data.by != me()` is the half that matters: without it either
        of you could answer your own memory, which is not what this field is
        and would read, forever, as somebody talking to themselves.

        Taking it back is a delete of the same key and arrives as the same
        affected key, so it needs no rule of its own.
      */
      allow update: if isOneOfUs()
        && resource.data.by != me()
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['theirs'])
        && (
          !request.resource.data.keys().hasAny(['theirs'])
          || (
            request.resource.data.theirs.by == me()
            && request.resource.data.theirs.body is string
            && request.resource.data.theirs.body.size() > 0
            && request.resource.data.theirs.body.size() <= 600
            && request.resource.data.theirs.at is number
          )
        );

      /*
        Taking one out of the glass — and it is an *update*, never a delete.

        A pane's place in the building is this document's index in the
        oldest-first list, so removing the document would slide every memory
        after it one bay down the Glasshouse. What happens instead is that the
        picture is deleted from the bucket for real and this document is
        emptied: `path` cleared, the colours blanked, both lines and any reply
        deleted, and a `removed` stamp left behind. What survives is a few
        bytes that say *there was a number here*.

        Only the one who hung it, which is the same shape as `theirs` and the
        opposite side of it: she may add a line to yours and never take it
        down; you may take yours down and never write the line.
      */
      allow update: if isOneOfUs()
        && resource.data.by == me()
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['removed', 'path', 'tint', 'blur', 'when', 'why', 'theirs'])
        && request.resource.data.removed.by == me()
        && request.resource.data.removed.at is number
        // The emptying is part of the rule, not a courtesy of the client: a
        // "removed" memory that still had its path would be a pane claiming to
        // be gone while its photograph sat in the bucket.
        && request.resource.data.path == ''
        // And it cannot be un-removed, which is what stops this rule being a
        // way to edit a memory in place by removing and rewriting it.
        && !('removed' in resource.data.keys());

      /*
        Nothing is ever *deleted*.

        The rest of the garden works this way — letters do not come down,
        flowers are never removed — and it matters more here than anywhere
        else, because this is the one collection whose contents cannot be made
        again. A delete rule on the documents would take the building's
        numbering with it.
      */
      allow delete: if false;
    }

    match /rounds/{roundId} {
      allow read: if isOneOfUs();

      // Opened once, by whoever gets there first, and never rewritten. Both of
      // you may open the same round at the same moment; the loser's write is
      // refused here rather than quietly changing the board mid-game.
      allow create: if isOneOfUs()
        && request.resource.data.gameId is string
        && request.resource.data.startedAt is number;

      allow update, delete: if false;

      // Named "${who}-${seq}", which is what lets these rules say "your own,
      // and never twice" without reading anything inside the document.
      match /moves/{moveId} {
        /*
          The opening move is the only one anyone commits blind: both choose at
          once, and hers stays unreadable until yours exists. Every later move
          is open, because a turn-based game where you cannot see her turn is
          not a game.

          ------------------------------------------------------------------
          **The racer is exempt, and it has to be exempt here rather than in
          the app.** A sealed opening is exactly right for Word Duel: seeing
          her word before choosing yours would end the game. It is exactly
          wrong for a time on a road. A lap time nobody may look at is not a
          challenge — it is a number in a drawer, and the whole shape of
          "leave her a line to chase" depends on the line being *visible* to
          the person chasing it.

          The seal was enforced down here, so no amount of work in the racer
          could have shown her that ghost: the read simply failed. Which is
          why the two of you sat on "nobody sees anybody's road until both
          first runs are here" and never got past it.

          Scoped by the round's own gameId rather than lifted, so Word Duel
          keeps its seal exactly as it was. The lookup costs one document read,
          and only on the path where the first three tests have already failed
          — which is precisely the case this clause exists for.
          ------------------------------------------------------------------
        */
        allow read: if isOneOfUs()
          && (!moveId.matches('.*-0')
              || moveId.matches(me() + '-.*')
              || exists(/databases/$(database)/documents/rounds/$(roundId)/moves/$(me() + '-0'))
              || get(/databases/$(database)/documents/rounds/$(roundId)).data.gameId == 'ember-rally');

        allow create: if isOneOfUs()
          && moveId.matches(me() + '-[0-9]+')
          && request.resource.data.by == me()
          && request.resource.data.seq is int
          && request.resource.data.seq >= 0
          && request.resource.data.at is number;

        allow update, delete: if false;
      }
    }

    // ---- the question vine ---------------------------------------------
    /*
      A question round is shared, but its two answers are separate documents.
      That shape is the seal: her answer cannot be read until the parent says
      both exist. There is no author/source field on a round, so a question
      that came out of either private seed pool becomes simply something the
      Tree is asking.
    */
    match /questionRounds/{roundId} {
      allow read: if isOneOfUs();

      allow create: if isOneOfUs()
        && request.resource.data.prompt is string
        && request.resource.data.prompt.size() > 0
        && request.resource.data.prompt.size() <= 600
        && request.resource.data.openedAt is number
        && request.resource.data.answeredWarm == false
        && request.resource.data.answeredCool == false
        && request.resource.data.keys().hasOnly([
          'prompt', 'openedAt', 'answeredWarm', 'answeredCool'
        ]);

      // Answering is the only mutation. Each caller may raise only their own
      // flag, exactly once; the second one also seals the completion time.
      allow update: if isOneOfUs() && (
        (
          me() == 'warm'
          && resource.data.answeredWarm == false
          && request.resource.data.answeredWarm == true
          && request.resource.data.answeredCool == resource.data.answeredCool
          && existsAfter(
            /databases/$(database)/documents/questionRounds/$(roundId)/answers/warm
          )
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['answeredWarm', 'completedAt'])
          && (
            (resource.data.answeredCool == true
              && request.resource.data.completedAt is number)
            ||
            (resource.data.answeredCool == false
              && request.resource.data.get('completedAt', null)
                   == resource.data.get('completedAt', null))
          )
        )
        ||
        (
          me() == 'cool'
          && resource.data.answeredCool == false
          && request.resource.data.answeredCool == true
          && request.resource.data.answeredWarm == resource.data.answeredWarm
          && existsAfter(
            /databases/$(database)/documents/questionRounds/$(roundId)/answers/cool
          )
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['answeredCool', 'completedAt'])
          && (
            (resource.data.answeredWarm == true
              && request.resource.data.completedAt is number)
            ||
            (resource.data.answeredWarm == false
              && request.resource.data.get('completedAt', null)
                   == resource.data.get('completedAt', null))
          )
        )
      );

      allow delete: if false;

      match /answers/{who} {
        // Mine is readable while it waits. Hers exists but is server-sealed
        // until the two public flags on the parent are both true.
        allow read: if isOneOfUs() && (
          who == me()
          || (
            get(/databases/$(database)/documents/questionRounds/$(roundId))
              .data.answeredWarm == true
            && get(/databases/$(database)/documents/questionRounds/$(roundId))
              .data.answeredCool == true
          )
        );

        allow create: if isOneOfUs()
          && who == me()
          && request.resource.data.by == me()
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 8000
          && request.resource.data.at is number
          // The answer and its public flag must land atomically.
          && (
            (me() == 'warm'
              && getAfter(/databases/$(database)/documents/questionRounds/$(roundId))
                   .data.answeredWarm == true)
            ||
            (me() == 'cool'
              && getAfter(/databases/$(database)/documents/questionRounds/$(roundId))
                   .data.answeredCool == true)
          );

        allow update, delete: if false;
      }
    }

    /*
      A planted question stays private to its planter. The other person's
      client cannot query or read it. A contribution seed is named by the
      immutable contribution it spends, which makes "one saving entry, one
      question" enforceable without a second credit ledger. The hidden admin
      door belongs to warm and uses an `admin-` id instead.
    */
    match /questionSeeds/{id} {
      allow read: if isOneOfUs() && resource.data.by == me();

      allow create: if isOneOfUs()
        && request.resource.data.by == me()
        && request.resource.data.prompt is string
        && request.resource.data.prompt.size() > 0
        && request.resource.data.prompt.size() <= 600
        && request.resource.data.plantedAt is number
        && request.resource.data.availableAfter is number
        && (
          (
            request.resource.data.get('contributionId', '') == id
            && get(/databases/$(database)/documents/contributions/$(id)).data.by == me()
            && get(/databases/$(database)/documents/contributions/$(id))
                 .data.inPotCurrency.minor > 0
          )
          ||
          (
            me() == 'warm'
            && id.matches('admin-.*')
            && request.resource.data.get('admin', false) == true
          )
        );

      allow update: if isOneOfUs()
        && resource.data.by == me()
        && !resource.data.keys().hasAny(['usedAt'])
        && request.resource.data.usedAt is number
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedAt']);

      allow delete: if false;
    }

    // ---- everything else ------------------------------------------------
    // Whatever comes next is closed rather than open-by-omission.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
