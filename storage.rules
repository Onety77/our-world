rules_version = '2';

/*
  The bucket. Photographs and brief voice-lights, and nothing else.

  This is the third rules file and the first one that guards *bytes*. Same law
  as the other two: two people, forever, matched by address, and everybody else
  reads and writes nothing at all — including anybody who signs in with a real,
  valid Firebase account.

  Do not fill the two addresses in by hand. Run `npm run rules`, which takes
  them from .env.local and writes rules-out/storage.rules ready to paste. One
  place to get it right instead of four, and the failure mode of getting it
  wrong is silent: uploads just fail and the Glasshouse looks broken for no
  visible reason.

  ---------------------------------------------------------------------------
  A note on what "private" means here, because it is the one place in this
  garden where it is not obvious.

  A Storage download URL carries a long unguessable token, and anybody holding
  that URL can fetch the file without signing in. That is how the image ends up
  in an `<img>` at all. So the honest statement is: the *bucket* is private and
  only the two of you can list it, upload to it, or ask for a URL — but a URL,
  once handed out, is a key. Nothing in the app ever puts one in an address
  bar, a link, or anything that leaves the device.
  ---------------------------------------------------------------------------
*/

service firebase.storage {
  match /b/{bucket}/o {

    function warmEmail() { return '__WARM_EMAIL__'; }
    function coolEmail() { return '__COOL_EMAIL__'; }

    /** Lowercased on both sides — see the note in firestore.rules. */
    function email() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function isOneOfUs() {
      return email() == warmEmail() || email() == coolEmail();
    }

    function me() {
      return email() == warmEmail() ? 'warm' : 'cool';
    }

    match /memories/{file} {
      allow read: if isOneOfUs();

      /*
        Create only. An existing object cannot be overwritten, because every
        upload goes to a path with a fresh id in it and nothing in this world
        edits a photograph. `resource == null` is what makes that a rule rather
        than a habit — with it, a bug that reused a path fails loudly instead of
        quietly replacing a memory with a different one.
      */
      allow create: if isOneOfUs()
        && resource == null
        // WebP where the browser had it, JPEG where it did not — see
        // systems/picture. Both, and nothing else: this is the only place a
        // content type is trusted, so the list is the list.
        && (request.resource.contentType == 'image/webp'
            || request.resource.contentType == 'image/jpeg')
        /*
          Eight megabytes. The client re-encodes everything to at most 2560
          pixels on the long edge before it gets here, which lands around half
          a megabyte — so this is not a limit anybody will meet. It is here so
          that a bug in the preparation step, or a client that has been
          tampered with, cannot fill the bucket.
        */
        && request.resource.size < 8 * 1024 * 1024;

      /* An uploaded picture is never edited. */
      allow update: if false;

      /*
        Delete is allowed, and this rule used to say it never would be.
        The note is kept because the reasoning still holds and the decision
        changed anyway.

        The old reasoning: this is the only data in the garden that cannot be
        made again, so a delete rule is a way to lose a photograph forever at
        three in the morning. That is true. What outweighs it is that "delete"
        has to *mean* delete — the Glasshouse offers to take a memory out of
        the glass, and an offer that quietly leaves the file in a bucket would
        be a lie about the one thing somebody might be deleting for.

        What guards it instead is everything around it: only the person who
        hung a memory can take it out (enforced in `firestore.rules`, where the
        document is), the interface asks twice, and there is no bulk anything.
        Storage cannot tell who hung which file, so the check that matters
        lives with the document and this rule is deliberately the looser half
        of the pair.
      */
      allow delete: if isOneOfUs();
    }

    match /voice-lights/{who}/{file} {
      allow read: if isOneOfUs();

      allow create: if isOneOfUs()
        && who == me()
        && resource == null
        && request.resource.contentType.matches('audio/(webm|mp4|ogg)(;.*)?')
        && request.resource.size < 3 * 1024 * 1024;

      allow update: if false;
      allow delete: if isOneOfUs() && who == me();
    }

    /* Everything outside the two byte stores, to everybody, forever. */
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
