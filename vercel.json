{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/push/firebase-messaging-sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/w", "destination": "/word.html" },
    { "source": "/w/:code*", "destination": "/word.html" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
