# Copy to .env.local and fill in. Nothing here has a plausible fallback: a
# missing key either throws by name at startup or lands you in the obviously
# fake local mode. See src/config.ts.

# `local` (default) — in-memory mock, nothing is saved, says so on screen.
# `firebase` — the real thing. Every VITE_FB_* key below becomes required.
VITE_DATA_BACKEND=local

VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_DATABASE_URL=
VITE_FB_STORAGE_BUCKET=
VITE_FB_MESSAGING_SENDER_ID=
VITE_FB_APP_ID=

# Firebase Console -> Project settings -> Cloud Messaging -> Web Push
# certificates -> Generate key pair. This is a public browser credential, not
# a server secret. It enables notifications after the installed app is closed.
VITE_FB_VAPID_KEY=

# The two sign-in addresses, one per light. There are exactly two people here,
# forever; anyone else is refused at the door.
VITE_WARM_EMAIL=
VITE_COOL_EMAIL=

# Seeds only — written on first run, then edited from the profile.
VITE_WARM_NAME=
VITE_WARM_CITY=
VITE_WARM_TZ=
VITE_WARM_LAT=
VITE_WARM_LON=

VITE_COOL_NAME=
VITE_COOL_CITY=
VITE_COOL_TZ=
VITE_COOL_LAT=
VITE_COOL_LON=

# ISO 4217. Everything in the pot is totalled in this.
VITE_POT_CURRENCY=

# Watching things together. Optional, and the asymmetry is deliberate: without
# it you can still paste a YouTube link and the two of you can watch it in step,
# you just cannot *search* from inside the garden.
#
# Google Cloud console -> enable "YouTube Data API v3" -> create an API key, and
# restrict it to that one API and to your own site. It is a browser credential,
# not a server secret. A free key gets 10,000 units a day and one search costs
# 100 of them, which is about ninety searches — plenty for two people, and worth
# knowing about before it stops one afternoon.
VITE_YOUTUBE_API_KEY=
